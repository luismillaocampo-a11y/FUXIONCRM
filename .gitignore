# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log
*.log

# runtime local (datos del operador, no distribuir ni versionar)
public/uploads/*
!public/uploads/.gitkeep
scratch/
scratch_leads_backup.json
*.backup.json

# IDE & Editor caches
.kilo/
.vscode/
.idea/

# Database files
*.sqlite
*.sqlite-shm
*.sqlite-wal
/db.sqlite
/db.sqlite-shm
/db.sqlite-wal

# WhatsApp session local credentials
/whatsapp_auth/
whatsapp_auth/

# License server local state
license-server/installations.json
/ADMIN_ONLY_GENERATOR

# env files
.env*
!.env.example
!.env.cloudrun.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build / dist outputs
/dist

