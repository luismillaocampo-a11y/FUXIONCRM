# ==============================================================================
# NutraFlow CRM - Variables de Entorno para Google Cloud Run (Producción)
# ==============================================================================
# Puedes inyectar estas variables en Cloud Run mediante:
# gcloud run services update nutraflow-crm --set-env-vars="CLAVE=VALOR,..."
# o desde la consola web de Google Cloud (Editar e implementar nueva revisión -> Variables).

# --- Base de Datos Persistente en Nube (Supabase PostgreSQL - 100% Free Tier) ---
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-de-supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-de-supabase
USE_SUPABASE=true

# --- Inteligencia Artificial (Google Gemini - Free Tier) ---
# Obtenida gratis en https://aistudio.google.com/
GEMINI_API_KEY=tu-gemini-api-key

# --- Seguridad y Autenticación de Sesión ---
JWT_SECRET=tu-clave-secreta-jwt-de-minimo-32-caracteres
AUTH_SALT=tu-sal-secreta-para-contraseñas
CRON_API_KEY=tu-clave-para-cron-jobs-seguros

# --- Webhooks de WhatsApp (Meta Cloud API / Evolution API) ---
WHATSAPP_VERIFY_TOKEN=tu-token-de-verificacion-meta
EVOLUTION_WEBHOOK_TOKEN=tu-token-del-webhook-evolution
WHATSAPP_APP_SECRET=tu-app-secret-de-meta-opcional

# --- Alertas por Correo SMTP (Opcional - Gmail App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion-de-16-caracteres
SMTP_FROM="NutraFlow CRM" <tu-correo@gmail.com>
ADMIN_EMAIL=tu-correo-personal@gmail.com
