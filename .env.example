# ==========================================
# NutraFlow CRM - Production Env Template
# ==========================================

# --- Supabase Database (REQUIRED for Production/Vercel) ---
# Locate these in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Gemini API (REQUIRED for FAQ Automation) ---
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key

# --- Notification Alerts (Nodemailer SMTP / Optional) ---
# Used to send payment verification alerts and manual mode prompts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@yourdomain.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM="NutraFlow CRM Alerts" <alerts@yourdomain.com>
ADMIN_EMAIL=your-admin-email@domain.com

# --- Auth & API Security (Bloque 1) ---
# Secreto de sesión (cámbialo en producción, si cambia invalida sesiones)
JWT_SECRET=change-me-32-chars-minimum
AUTH_SALT=change-me-salt
# Clave para crons: /api/cron/* acepta sesión o Bearer/api_key. Sin esto, solo sesión.
CRON_API_KEY=change-me-cron-key
# Verify token de Meta (GET /api/webhook/whatsapp). Sin esto el verify responde 500.
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
# Token del webhook Evolution (POST /api/webhook/whatsapp). Se exige solo si está configurado.
EVOLUTION_WEBHOOK_TOKEN=change-me-webhook-token
# App secret de Meta para verificar X-Hub-Signature-256 (opcional pero recomendado)
WHATSAPP_APP_SECRET=

# --- Licencias (auto-vinculación a PC, sin seriales) ---
# Servidor de licencias (opcional, para después): si se define, el CRM reporta
# cada instalación y acata bloqueos/planes. Sin esto, rige solo el candado local.
#LICENSE_SERVER_URL=https://tu-servidor-de-licencias/api/checkin
# Contacto que verá un cliente si su instalación queda bloqueada
LICENSE_VENDOR_CONTACT=Soporte NutraFlow CRM
